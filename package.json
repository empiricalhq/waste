{
  "name": "workspaces",
  "private": true,
  "packageManager": "bun@1.3.1",
  "workspaces": [
    "packages/database",
    "packages/email",
    "apps/*"
  ],
  "scripts": {
    "clean": "rm -rf node_modules packages/database/node_modules apps/citizen/node_modules bun.lock packages/database/bun.lock apps/citizen/bun.lock",
    "format": "biome check --write --unsafe ."
  },
  "devDependencies": {
    "@types/bun": "^1.3.1"
  },
  "resolutions": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2"
  }
}
